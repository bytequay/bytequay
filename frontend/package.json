{
  "name": "bytequay",
  "productName": "ByteQuay",
  "version": "0.5.4",
  "description": "GitHub pull requests and local coding agents for macOS",
  "main": ".vite/build/main.js",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "postinstall": "install-electron --no && chmod +x node_modules/node-pty/prebuilds/darwin-*/spawn-helper",
    "lint": "eslint --ext .ts,.tsx .",
    "test": "vitest run",
    "check:licenses": "license-checker-rseidelsohn --production --onlyAllow 'Apache-2.0;MIT;BSD-2-Clause;BSD-3-Clause;ISC;CC0-1.0;0BSD;CC-BY-4.0;CC-BY-3.0;Python-2.0;Unlicense;BlueOak-1.0.0' --excludePackagesStartingWith 'bytequay;@bytequay/'",
    "build:plugins": "npm run build --workspaces --if-present",
    "prestart": "npm run build:plugins",
    "prepackage": "npm run build:plugins",
    "premake": "npm run build:plugins",
    "pretest": "npm run build:plugins",
    "prelint": "npm run build:plugins"
  },
  "keywords": [],
  "author": {
    "name": "chenjian2664",
    "email": "chenjian2664@gmail.com"
  },
  "license": "Apache-2.0",
  "overrides": {
    "jschardet": "npm:chardet@2.2.0",
    "@electron-forge/cli": {
      "commander@11": "12.1.0"
    }
  },
  "devDependencies": {
    "@codingame/esbuild-import-meta-url-plugin": "1.0.3",
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "44.5.1",
    "esbuild": "^0.21.5",
    "eslint": "^8.57.1",
    "eslint-plugin-header": "^3.1.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "license-checker-rseidelsohn": "^4.4.2",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "@codingame/monaco-vscode-api": "33.0.9",
    "@codingame/monaco-vscode-configuration-service-override": "33.0.9",
    "@codingame/monaco-vscode-debug-service-override": "33.0.9",
    "@codingame/monaco-vscode-explorer-service-override": "33.0.9",
    "@codingame/monaco-vscode-go-default-extension": "33.0.9",
    "@codingame/monaco-vscode-java-default-extension": "33.0.9",
    "@codingame/monaco-vscode-javascript-default-extension": "33.0.9",
    "@codingame/monaco-vscode-keybindings-service-override": "33.0.9",
    "@codingame/monaco-vscode-languages-service-override": "33.0.9",
    "@codingame/monaco-vscode-model-service-override": "33.0.9",
    "@codingame/monaco-vscode-remote-agent-service-override": "33.0.9",
    "@codingame/monaco-vscode-rust-default-extension": "33.0.9",
    "@codingame/monaco-vscode-scm-service-override": "33.0.9",
    "@codingame/monaco-vscode-search-service-override": "33.0.9",
    "@codingame/monaco-vscode-storage-service-override": "33.0.9",
    "@codingame/monaco-vscode-task-service-override": "33.0.9",
    "@codingame/monaco-vscode-terminal-service-override": "33.0.9",
    "@codingame/monaco-vscode-testing-service-override": "33.0.9",
    "@codingame/monaco-vscode-textmate-service-override": "33.0.9",
    "@codingame/monaco-vscode-theme-defaults-default-extension": "33.0.9",
    "@codingame/monaco-vscode-theme-service-override": "33.0.9",
    "@codingame/monaco-vscode-views-service-override": "33.0.9",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "chardet": "2.2.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.40.0",
    "mermaid": "11.17.2",
    "monaco-editor": "npm:@codingame/monaco-vscode-editor-api@33.0.9",
    "node-pty": "1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vscode": "npm:@codingame/monaco-vscode-extension-api@33.0.9",
    "@bytequay/ui": "0.5.4",
    "@bytequay/google": "0.5.4",
    "@bytequay/lab": "0.5.4",
    "@bytequay/jira": "0.5.4"
  },
  "workspaces": [
    "packages/*",
    "plugins/*"
  ]
}
