#!/usr/bin/env bash

set -euo pipefail

usage()
{
    cat <<'EOF'
Usage: ci-autofix pr <owner/repository> <number> --workspace <workspace-id>

Environment:
  BYTEQUAY_DESKTOP_SESSION_TOKEN  Override the token written by ./dev.sh
  BYTEQUAY_BACKEND_URL            Backend URL (overrides BYTEQUAY_BACKEND_PORT)
  BYTEQUAY_BACKEND_PORT           Local backend port (default 9527)
  BYTEQUAY_CI_AUTOFIX_POLL_SECONDS Poll interval (default 2)
EOF
}

workspace_id=
if [[ "${1:-}" == --help ]]; then
    usage
    exit 0
fi
if [[ "${1:-}" != pr || ! "${2:-}" =~ ^[^/]+/[^/]+$ || ! "${3:-}" =~ ^[1-9][0-9]*$ ]]; then
    usage >&2
    exit 2
fi
requested_repository="$2"
pull_request_number="$3"
shift 3
while [[ $# -gt 0 ]]; do
    case "$1" in
        --workspace)
            workspace_id="${2:-}"
            [[ -n "$workspace_id" ]] || {
                echo "--workspace requires a saved ByteQuay workspace ID" >&2
                exit 2
            }
            shift
            ;;
        --help)
            usage
            exit 0
            ;;
        *)
            usage >&2
            exit 2
            ;;
    esac
    shift
done
[[ -n "$workspace_id" ]] || {
    echo "--workspace is required" >&2
    usage >&2
    exit 2
}

for command in curl jq; do
    command -v "$command" >/dev/null || {
        echo "Missing required command: $command" >&2
        exit 1
    }
done

base_url="${BYTEQUAY_BACKEND_URL:-http://127.0.0.1:${BYTEQUAY_BACKEND_PORT:-9527}}"
base_url="${base_url%/}"
session_token="${BYTEQUAY_DESKTOP_SESSION_TOKEN:-}"
poll_seconds="${BYTEQUAY_CI_AUTOFIX_POLL_SECONDS:-2}"
if [[ -z "$session_token" ]]; then
    token_file="$HOME/Library/Application Support/ByteQuay/desktop-session-token"
    [[ -r "$token_file" ]] && session_token="$(<"$token_file")"
fi
[[ -n "$session_token" ]] || {
    echo "No desktop session token found; start the backend with ./dev.sh or set BYTEQUAY_DESKTOP_SESSION_TOKEN" >&2
    exit 1
}
[[ "$poll_seconds" =~ ^[0-9]+([.][0-9]+)?$ ]] || {
    echo "BYTEQUAY_CI_AUTOFIX_POLL_SECONDS must be a non-negative number" >&2
    exit 2
}

repository="$requested_repository"

api()
{
    curl -fsS --noproxy '*' --connect-timeout 2 --max-time 30 \
        -H "X-ByteQuay-Session: $session_token" "$@"
}

print_event()
{
    jq -r '
        if .type == "assistant_message" and .payload.phase == "FINAL" then
            "agent> \(.payload.text)"
        elif .type == "assistant_message" then
            empty
        elif .type == "command" and .payload.state == "STARTED" then
            "command> \(.payload.argv | join(" "))"
        elif .type == "command" and .payload.state == "PROGRESS" then
            "output> \(.payload.output // "")"
        elif .type == "command" then
            (if (.payload.output // "") != "" then "output> \(.payload.output)" else empty end),
            "command> \(.payload.state | ascii_downcase) (exit \(.payload.exitCode // "unknown"))"
        elif .type == "tool" then
            "tool> \(.payload.name) \(.payload.state | ascii_downcase)"
        elif .type == "plan_updated" then
            .payload.items[] | "plan> \(.state | ascii_downcase): \(.text)"
        elif .type == "error" then
            "error> \(.payload.message)"
        elif .type == "approval_requested" then
            "approval> \(.payload.title)"
        elif .type == "lifecycle" then
            "agent-status> \(.payload.message)"
        else
            "event> #\(.sequence) \(.type)"
        end'
}

workspace="$(api "$base_url/api/workspaces/$workspace_id")"
workspace_repository="$(jq -er '.monitoredOwner + "/" + .monitoredRepo' <<<"$workspace")"
shopt -s nocasematch
if [[ "$repository" != "$workspace_repository" ]]; then
    echo "Requested repository $repository does not match workspace $workspace_id ($workspace_repository)" >&2
    exit 1
fi
shopt -u nocasematch
repository="$workspace_repository"

run="$(api "$base_url/api/ci-autofix/runs?limit=200" | jq -c \
    --arg workspaceId "$workspace_id" \
    --arg repository "$repository" \
    --argjson pullRequestNumber "$pull_request_number" \
    'first(.[] | select(
        .workspaceId == $workspaceId and
        .repository == $repository and
        .pullRequestNumber == $pullRequestNumber and
        .status != "FINISHED")) // empty')"

[[ -n "$run" ]] || {
    echo "No active CI Autofix run for $repository#$pull_request_number in workspace $workspace_id; turn on Auto-CI fix in a ByteQuay task's automation to start one" >&2
    exit 1
}
echo "Attaching to CI Autofix run $(jq -r '.id' <<<"$run")"
jq -r 'select(.generatedLocalBranch != null) | "Local task branch: \(.generatedLocalBranch)"' <<<"$run"

run_id="$(jq -er '.id' <<<"$run")"
last_version=-1
last_sequence=0
seen_failures=0
seen_warnings=0

detach()
{
    printf '\nDetached; CI Autofix continues in the backend.\n'
    exit 130
}
trap detach INT

while true; do
    run="$(api "$base_url/api/ci-autofix/runs/$run_id")"
    version="$(jq -er '.version' <<<"$run")"
    if [[ "$version" != "$last_version" ]]; then
        jq -r '"run> \(.status | ascii_downcase) / \(.activity | ascii_downcase) — head \(.expectedRemoteHead[0:12]), attempts \(.attemptsUsed)/\(.authorization.maxAttempts), reruns \(.rerunsUsed)"' <<<"$run"
        last_version="$version"
    fi

    failures="$(jq -c '[.attempts[] | .failures[]]' <<<"$run")"
    failure_count="$(jq 'length' <<<"$failures")"
    if (( failure_count > seen_failures )); then
        jq -r --argjson start "$seen_failures" '.[$start:][] | "ci> \(.summary) (workflow \(.workflowRunId), job \(.jobId))"' <<<"$failures"
        seen_failures="$failure_count"
    fi

    warning_count="$(jq '.warnings | length' <<<"$run")"
    if (( warning_count > seen_warnings )); then
        jq -r --argjson start "$seen_warnings" '.warnings[$start:][] | "warning> \(.message)"' <<<"$run"
        seen_warnings="$warning_count"
    fi

    task_id="$(jq -r '.agentTaskId // empty' <<<"$run")"
    if [[ -n "$task_id" ]]; then
        while true; do
            events="$(api "$base_url/agent/tasks/$task_id/events?after=$last_sequence&limit=1000")"
            event_count="$(jq 'length' <<<"$events")"
            while IFS= read -r event; do
                [[ -n "$event" ]] && print_event <<<"$event"
            done < <(jq -c '.[]' <<<"$events")
            if (( event_count > 0 )); then
                last_sequence="$(jq -er '.[-1].sequence' <<<"$events")"
            fi
            (( event_count == 1000 )) || break
        done
    fi

    status="$(jq -er '.status' <<<"$run")"
    if [[ "$status" == FINISHED ]]; then
        jq -r '"finished> \(.finishReason // "UNKNOWN"): \(.summary // "No summary")"' <<<"$run"
        [[ "$(jq -r '.finishReason // ""' <<<"$run")" == GREEN ]]
        exit
    fi
    if [[ "$status" == PAUSED ]]; then
        jq -r '"paused> \(.pauseReason // "UNKNOWN"): \(.summary // "No summary")"' <<<"$run"
        if [[ ! -t 0 ]]; then
            exit 2
        fi
        if ! IFS= read -r -p "Message the agent, /cancel, or /quit: " message || [[ "$message" == /quit ]]; then
            echo "Detached; CI Autofix remains paused."
            exit 2
        fi
        if [[ "$message" == /cancel ]]; then
            run="$(api -X POST "$base_url/api/ci-autofix/runs/$run_id/cancel")"
        elif [[ -n "$message" ]]; then
            run="$(api \
                -H 'Content-Type: application/json' \
                -H "Idempotency-Key: ci-autofix-message-$(date +%s)-$$" \
                -d "$(jq -n --arg message "$message" '{message: $message}')" \
                "$base_url/api/ci-autofix/runs/$run_id/messages")"
        fi
        continue
    fi
    sleep "$poll_seconds"
done
