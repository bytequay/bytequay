{
  "name": "GitHub Dark",
  "type": "dark",
  "colors": {
    "foreground": "#e6edf3",
    "descriptionForeground": "#8b949e",
    "focusBorder": "#58a6ff",
    "textLink.foreground": "#58a6ff",
    "icon.foreground": "#8b949e",
    "editor.background": "#0d1117",
    "editor.foreground": "#e6edf3",
    "editorLineNumber.foreground": "#6e7681",
    "editorLineNumber.activeForeground": "#e6edf3",
    "editorCursor.foreground": "#58a6ff",
    "editor.selectionBackground": "#388bfd66",
    "editor.inactiveSelectionBackground": "#388bfd26",
    "editor.lineHighlightBackground": "#161b22",
    "editorBracketMatch.background": "#23863633",
    "editorBracketMatch.border": "#3fb950",
    "editorIndentGuide.background1": "#21262d",
    "editorIndentGuide.activeBackground1": "#6e7681",
    "editorGutter.addedBackground": "#3fb950",
    "editorGutter.modifiedBackground": "#58a6ff",
    "editorGutter.deletedBackground": "#f85149",
    "editorWidget.background": "#161b22",
    "editorWidget.border": "#30363d",
    "editorGroupHeader.tabsBackground": "#161b22",
    "editorGroup.border": "#30363d",
    "tab.activeBackground": "#0d1117",
    "tab.activeForeground": "#e6edf3",
    "tab.activeBorderTop": "#f78166",
    "tab.inactiveBackground": "#161b22",
    "tab.inactiveForeground": "#8b949e",
    "tab.border": "#30363d",
    "sideBar.background": "#161b22",
    "sideBar.foreground": "#e6edf3",
    "sideBar.border": "#30363d",
    "panel.background": "#161b22",
    "panel.border": "#30363d",
    "activityBar.background": "#161b22",
    "statusBar.background": "#0d1117",
    "statusBar.foreground": "#8b949e",
    "list.hoverBackground": "#21262d",
    "list.activeSelectionBackground": "#1f6feb",
    "list.activeSelectionForeground": "#ffffff",
    "list.inactiveSelectionBackground": "#1c2d41",
    "list.inactiveSelectionForeground": "#e6edf3",
    "input.background": "#0d1117",
    "input.foreground": "#e6edf3",
    "input.border": "#30363d",
    "dropdown.background": "#161b22",
    "dropdown.foreground": "#e6edf3",
    "dropdown.border": "#30363d",
    "diffEditor.insertedLineBackground": "#23863626",
    "diffEditor.removedLineBackground": "#f8514926"
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#8b949e" } },
    { "scope": ["keyword", "storage", "constant.language", "variable.language"], "settings": { "foreground": "#ff7b72" } },
    { "scope": "string", "settings": { "foreground": "#a5d6ff" } },
    { "scope": ["constant.numeric", "constant.other", "variable.other.constant"], "settings": { "foreground": "#79c0ff" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#d2a8ff" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type", "storage.type.java", "storage.type.object.array.java", "entity.other.inherited-class.java"], "settings": { "foreground": "#ffa657" } },
    { "scope": ["variable.other", "variable.parameter"], "settings": { "foreground": "#e6edf3" } },
    { "scope": "entity.name.tag", "settings": { "foreground": "#7ee787" } },
    { "scope": ["entity.other.attribute-name", "support.type.property-name"], "settings": { "foreground": "#79c0ff" } }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "keyword": { "foreground": "#ff7b72" },
    "modifier": "#ff7b72",
    "operator": "#ff7b72",
    "type": "#ffa657",
    "class": "#ffa657",
    "enum": "#ffa657",
    "struct": "#ffa657",
    "interface": "#ffa657",
    "typeParameter": "#ffa657",
    "namespace": "#ffa657",
    "function": "#d2a8ff",
    "method": "#d2a8ff",
    "property": "#e6edf3",
    "enumMember": "#79c0ff",
    "variable.readonly": "#79c0ff",
    "string": "#a5d6ff",
    "number": "#79c0ff",
    "comment": { "foreground": "#8b949e" },
    "parameter": "#e6edf3",
    "variable": "#e6edf3"
  }
}
