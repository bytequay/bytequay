{
  "name": "@bytequay/lab",
  "version": "0.5.4",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./contracts": "./dist/contracts.js",
    "./main": "./dist/main.js",
    "./preload": "./dist/preload.js",
    "./renderer": "./dist/renderer.js"
  },
  "typesVersions": {
    "*": {
      "contracts": [
        "dist/contracts.d.ts"
      ],
      "main": [
        "dist/main.d.ts"
      ],
      "preload": [
        "dist/preload.d.ts"
      ],
      "renderer": [
        "dist/renderer.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "eslint --ext .ts,.tsx src",
    "test": "vitest run --config ../../vitest.config.ts",
    "prebuild": "npm run build --workspace=@bytequay/ui",
    "pretest": "npm run build",
    "prelint": "npm run build"
  },
  "dependencies": {
    "@bytequay/ui": "0.5.4"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "devDependencies": {
    "electron": "44.5.1"
  }
}
