{
  "name": "GitHub Dark",
  "type": "dark",
  "colors": {
    "foreground": "#abb2bf",
    "descriptionForeground": "#858e9b",
    "focusBorder": "#6f96c1",
    "textLink.foreground": "#6f96c1",
    "icon.foreground": "#858e9b",
    "editor.background": "#1e2025",
    "editor.foreground": "#abb2bf",
    "editorLineNumber.foreground": "#6e7681",
    "editorLineNumber.activeForeground": "#abb2bf",
    "editorCursor.foreground": "#6f96c1",
    "editor.selectionBackground": "#388bfd66",
    "editor.inactiveSelectionBackground": "#388bfd26",
    "editor.lineHighlightBackground": "#24272e",
    "editorBracketMatch.background": "#23863633",
    "editorBracketMatch.border": "#79a985",
    "editorIndentGuide.background1": "#30353e",
    "editorIndentGuide.activeBackground1": "#6e7681",
    "editorGutter.addedBackground": "#79a985",
    "editorGutter.modifiedBackground": "#6f96c1",
    "editorGutter.deletedBackground": "#cf7d7d",
    "editorWidget.background": "#24272e",
    "editorWidget.border": "#333943",
    "editorGroupHeader.tabsBackground": "#24272e",
    "editorGroup.border": "#333943",
    "tab.activeBackground": "#1e2025",
    "tab.activeForeground": "#abb2bf",
    "tab.activeBorderTop": "#bc8679",
    "tab.inactiveBackground": "#24272e",
    "tab.inactiveForeground": "#858e9b",
    "tab.border": "#333943",
    "sideBar.background": "#24272e",
    "sideBar.foreground": "#abb2bf",
    "sideBar.border": "#333943",
    "panel.background": "#24272e",
    "panel.border": "#333943",
    "activityBar.background": "#24272e",
    "statusBar.background": "#1e2025",
    "statusBar.foreground": "#858e9b",
    "list.hoverBackground": "#30353e",
    "list.activeSelectionBackground": "#2f4762",
    "list.activeSelectionForeground": "#c9cdd4",
    "list.inactiveSelectionBackground": "#293848",
    "list.inactiveSelectionForeground": "#abb2bf",
    "input.background": "#1e2025",
    "input.foreground": "#abb2bf",
    "input.border": "#333943",
    "dropdown.background": "#24272e",
    "dropdown.foreground": "#abb2bf",
    "dropdown.border": "#333943",
    "diffEditor.insertedLineBackground": "#23863626",
    "diffEditor.removedLineBackground": "#f8514926"
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#858e9b" } },
    { "scope": ["keyword", "storage", "constant.language", "variable.language"], "settings": { "foreground": "#cf7d7d" } },
    { "scope": "string", "settings": { "foreground": "#91afc6" } },
    { "scope": ["constant.numeric", "constant.other", "variable.other.constant"], "settings": { "foreground": "#7fa4c7" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#b39ac9" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type", "storage.type.java", "storage.type.object.array.java", "entity.other.inherited-class.java"], "settings": { "foreground": "#c89f78" } },
    { "scope": ["variable.other", "variable.parameter"], "settings": { "foreground": "#abb2bf" } },
    { "scope": "entity.name.tag", "settings": { "foreground": "#8fb49a" } },
    { "scope": ["entity.other.attribute-name", "support.type.property-name"], "settings": { "foreground": "#7fa4c7" } }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "keyword": { "foreground": "#cf7d7d" },
    "modifier": "#cf7d7d",
    "operator": "#cf7d7d",
    "type": "#c89f78",
    "class": "#c89f78",
    "enum": "#c89f78",
    "struct": "#c89f78",
    "interface": "#c89f78",
    "typeParameter": "#c89f78",
    "namespace": "#c89f78",
    "function": "#b39ac9",
    "method": "#b39ac9",
    "property": "#abb2bf",
    "enumMember": "#7fa4c7",
    "variable.readonly": "#7fa4c7",
    "string": "#91afc6",
    "number": "#7fa4c7",
    "comment": { "foreground": "#858e9b" },
    "parameter": "#abb2bf",
    "variable": "#abb2bf"
  }
}
