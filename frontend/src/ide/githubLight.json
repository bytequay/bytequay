{
  "name": "GitHub Light",
  "type": "light",
  "colors": {
    "foreground": "#1f2328",
    "descriptionForeground": "#656d76",
    "focusBorder": "#0969da",
    "textLink.foreground": "#0969da",
    "icon.foreground": "#656d76",
    "editor.background": "#ffffff",
    "editor.foreground": "#1f2328",
    "editorLineNumber.foreground": "#8c959f",
    "editorLineNumber.activeForeground": "#1f2328",
    "editorCursor.foreground": "#0969da",
    "editor.selectionBackground": "#0969da33",
    "editor.inactiveSelectionBackground": "#0969da12",
    "editor.lineHighlightBackground": "#f6f8fa",
    "editorBracketMatch.background": "#dafbe1",
    "editorBracketMatch.border": "#82cf9c",
    "editorIndentGuide.background1": "#d8dee4",
    "editorIndentGuide.activeBackground1": "#8c959f",
    "editorGutter.addedBackground": "#1a7f37",
    "editorGutter.modifiedBackground": "#0969da",
    "editorGutter.deletedBackground": "#cf222e",
    "editorWidget.background": "#ffffff",
    "editorWidget.border": "#d0d7de",
    "editorGroupHeader.tabsBackground": "#f6f8fa",
    "editorGroup.border": "#d0d7de",
    "tab.activeBackground": "#ffffff",
    "tab.activeForeground": "#1f2328",
    "tab.activeBorderTop": "#fd8c73",
    "tab.inactiveBackground": "#f6f8fa",
    "tab.inactiveForeground": "#656d76",
    "tab.border": "#d0d7de",
    "sideBar.background": "#f6f8fa",
    "sideBar.foreground": "#1f2328",
    "sideBar.border": "#d0d7de",
    "panel.background": "#f6f8fa",
    "panel.border": "#d0d7de",
    "activityBar.background": "#f6f8fa",
    "statusBar.background": "#ffffff",
    "statusBar.foreground": "#656d76",
    "list.hoverBackground": "#eaeef2",
    "list.activeSelectionBackground": "#0969da",
    "list.activeSelectionForeground": "#ffffff",
    "list.inactiveSelectionBackground": "#ddf4ff",
    "list.inactiveSelectionForeground": "#1f2328",
    "input.background": "#ffffff",
    "input.foreground": "#1f2328",
    "input.border": "#d0d7de",
    "dropdown.background": "#ffffff",
    "dropdown.foreground": "#1f2328",
    "dropdown.border": "#d0d7de",
    "diffEditor.insertedLineBackground": "#dafbe1",
    "diffEditor.removedLineBackground": "#ffebe9"
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#6e7781" } },
    { "scope": ["keyword", "storage", "constant.language", "variable.language"], "settings": { "foreground": "#cf222e" } },
    { "scope": "string", "settings": { "foreground": "#0a3069" } },
    { "scope": ["constant.numeric", "constant.other", "variable.other.constant"], "settings": { "foreground": "#0550ae" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#8250df" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type", "storage.type.java", "storage.type.object.array.java", "entity.other.inherited-class.java"], "settings": { "foreground": "#953800" } },
    { "scope": ["variable.other", "variable.parameter"], "settings": { "foreground": "#1f2328" } },
    { "scope": "entity.name.tag", "settings": { "foreground": "#116329" } },
    { "scope": ["entity.other.attribute-name", "support.type.property-name"], "settings": { "foreground": "#0550ae" } }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "keyword": { "foreground": "#cf222e" },
    "modifier": "#cf222e",
    "operator": "#cf222e",
    "type": "#953800",
    "class": "#953800",
    "enum": "#953800",
    "struct": "#953800",
    "interface": "#953800",
    "typeParameter": "#953800",
    "namespace": "#953800",
    "function": "#8250df",
    "method": "#8250df",
    "property": "#1f2328",
    "enumMember": "#0550ae",
    "variable.readonly": "#0550ae",
    "string": "#0a3069",
    "number": "#0550ae",
    "comment": { "foreground": "#6e7781" },
    "parameter": "#1f2328",
    "variable": "#1f2328"
  }
}
