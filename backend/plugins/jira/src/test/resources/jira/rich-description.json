            }
          ]
        },
        {
          "type": "text",
          "text": " column from the Harbor connector through its parallel (Arrow) page source fails with a bare "
        },
        {
          "type": "text",
          "text": "java.lang.ArithmeticException: Rounding necessary",
          "marks": [
            {
              "type": "code"
            }
          ]
        },
        {
          "type": "text",
          "text": " whenever the value Harbor returns has more fractional digits than the scale Harbor reported for that column. 42 failures in a week across three accounts."
        }
      ]
