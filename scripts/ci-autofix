#!/usr/bin/env bash

set -euo pipefail

usage()
{
    cat <<'EOF'
Usage: ci-autofix pr <owner/repository> <number> [--lane codex|claude] [--max-attempts 1..3]

Environment:
  BYTEQUAY_DESKTOP_SESSION_TOKEN  Override the token written by ./dev.sh
  BYTEQUAY_BACKEND_URL            Backend URL (default http://127.0.0.1:53123)
  BYTEQUAY_CI_AUTOFIX_POLL_SECONDS Poll interval (default 2)
EOF
}

lane=claude
max_attempts=3
if [[ "${1:-}" == --help ]]; then
    usage
    exit 0
fi
if [[ "${1:-}" != pr || ! "${2:-}" =~ ^[^/]+/[^/]+$ || ! "${3:-}" =~ ^[1-9][0-9]*$ ]]; then
    usage >&2
    exit 2
fi
requested_repository="$2"
pull_request_number="$3"
shift 3
while [[ $# -gt 0 ]]; do
    case "$1" in
        --lane)
            lane="${2:-}"
            [[ "$lane" == codex || "$lane" == claude ]] || {
                echo "--lane requires codex or claude" >&2
                exit 2
            }
            shift
            ;;
        --max-attempts)
            max_attempts="${2:-}"
            [[ "$max_attempts" =~ ^[1-3]$ ]] || {
                echo "--max-attempts requires 1, 2, or 3" >&2
                exit 2
            }
            shift
            ;;
        --help)
            usage
            exit 0
            ;;
        *)
            usage >&2
            exit 2
            ;;
    esac
    shift
done

for command in curl git jq; do
    command -v "$command" >/dev/null || {
        echo "Missing required command: $command" >&2
        exit 1
    }
done

base_url="${BYTEQUAY_BACKEND_URL:-http://127.0.0.1:53123}"
base_url="${base_url%/}"
session_token="${BYTEQUAY_DESKTOP_SESSION_TOKEN:-}"
poll_seconds="${BYTEQUAY_CI_AUTOFIX_POLL_SECONDS:-2}"
if [[ -z "$session_token" ]]; then
    token_file="$HOME/Library/Application Support/ByteQuay/desktop-session-token"
    [[ -r "$token_file" ]] && session_token="$(<"$token_file")"
fi
[[ -n "$session_token" ]] || {
    echo "No desktop session token found; start the backend with ./dev.sh or set BYTEQUAY_DESKTOP_SESSION_TOKEN" >&2
    exit 1
}
[[ "$poll_seconds" =~ ^[0-9]+([.][0-9]+)?$ ]] || {
    echo "BYTEQUAY_CI_AUTOFIX_POLL_SECONDS must be a non-negative number" >&2
    exit 2
}

worktree="$(git rev-parse --show-toplevel)"
remote="$(git -C "$worktree" remote get-url origin)"
case "$remote" in
    git@github.com:*) worktree_repository="${remote#git@github.com:}" ;;
    https://github.com/*) worktree_repository="${remote#https://github.com/}" ;;
    ssh://git@github.com/*) worktree_repository="${remote#ssh://git@github.com/}" ;;
    *)
        echo "origin is not a supported GitHub remote: $remote" >&2
        exit 1
        ;;
esac
worktree_repository="${worktree_repository%.git}"
[[ "$worktree_repository" =~ ^[^/]+/[^/]+$ ]] || {
    echo "Cannot derive owner/repository from origin: $remote" >&2
    exit 1
}
shopt -s nocasematch
if [[ "$requested_repository" != "$worktree_repository" ]]; then
    echo "Requested repository $requested_repository does not match worktree origin $worktree_repository" >&2
    exit 1
fi
shopt -u nocasematch
repository="$worktree_repository"

api()
{
    curl -fsS --noproxy '*' --connect-timeout 2 --max-time 30 \
        -H "X-ByteQuay-Session: $session_token" "$@"
}

print_event()
{
    jq -r '
        if .type == "assistant_message" and .payload.phase == "FINAL" then
            "agent> \(.payload.text)"
        elif .type == "assistant_message" then
            empty
        elif .type == "command" and .payload.state == "STARTED" then
            "command> \(.payload.argv | join(" "))"
        elif .type == "command" and .payload.state == "PROGRESS" then
            "output> \(.payload.output // "")"
        elif .type == "command" then
            (if (.payload.output // "") != "" then "output> \(.payload.output)" else empty end),
            "command> \(.payload.state | ascii_downcase) (exit \(.payload.exitCode // "unknown"))"
        elif .type == "tool" then
            "tool> \(.payload.name) \(.payload.state | ascii_downcase)"
        elif .type == "plan_updated" then
            .payload.items[] | "plan> \(.state | ascii_downcase): \(.text)"
        elif .type == "error" then
            "error> \(.payload.message)"
        elif .type == "approval_requested" then
            "approval> \(.payload.title)"
        elif .type == "lifecycle" then
            "agent-status> \(.payload.message)"
        else
            "event> #\(.sequence) \(.type)"
        end'
}

existing="$(api "$base_url/api/ci-autofix/runs?limit=200" | jq -c \
    --arg repository "$repository" \
    --argjson pullRequestNumber "$pull_request_number" \
    'first(.[] | select(
        .repository == $repository and
        .pullRequestNumber == $pullRequestNumber and
        .status != "FINISHED")) // empty')"

if [[ -n "$existing" ]]; then
    run="$existing"
    echo "Attaching to existing CI Autofix run $(jq -r '.id' <<<"$run")"
else
    provider="$(api "$base_url/agent/providers/status" | jq -c \
        --arg lane "$lane" \
        'first(.[] | select(.laneId == $lane)) // empty')"
    [[ -n "$provider" ]] || {
        echo "Agent lane $lane is not enabled by the backend" >&2
        exit 1
    }
    [[ "$(jq -r '.readiness' <<<"$provider")" =~ ^(READY|DEGRADED)$ ]] || {
        echo "Agent lane $lane is unavailable: $(jq -r '.diagnostic' <<<"$provider")" >&2
        exit 1
    }
    jq -e '.capabilities.permissionPolicies | index("CI_AUTOFIX") != null' \
        <<<"$provider" >/dev/null || {
        echo "Agent lane $lane cannot enforce CI_AUTOFIX; use --lane claude" >&2
        exit 1
    }
    if [[ -n "$(git -C "$worktree" status --porcelain)" ]]; then
        echo "Worktree must be clean before starting CI Autofix: $worktree" >&2
        exit 1
    fi
    branch="$(git -C "$worktree" branch --show-current)"
    echo "Repository: $repository"
    echo "Pull request: #$pull_request_number"
    echo "Worktree: $worktree"
    echo "Branch: $branch"
    echo "Agent lane: $lane"
    echo "Authorization: up to $max_attempts fix attempts, failed-job reruns, local history rewrites, and exact-lease pushes"
    if ! IFS= read -r -p "Start CI Autofix? [y/N] " consent || [[ ! "$consent" =~ ^[Yy]$ ]]; then
        echo "Not started"
        exit 1
    fi
    request="$(jq -n \
        --arg repository "$repository" \
        --argjson pullRequestNumber "$pull_request_number" \
        --arg worktree "$worktree" \
        --arg laneId "$lane" \
        --argjson maxAttempts "$max_attempts" \
        '{
            repository: $repository,
            pullRequestNumber: $pullRequestNumber,
            worktree: $worktree,
            laneId: $laneId,
            maxAttempts: $maxAttempts,
            allowFailedJobReruns: true,
            allowHistoryRewrites: true,
            allowExactLeasePush: true
        }')"
    run="$(api \
        -H 'Content-Type: application/json' \
        -H "Idempotency-Key: ci-autofix-shell-$(date +%s)-$$" \
        -d "$request" \
        "$base_url/api/ci-autofix/runs")"
    echo "Started CI Autofix run $(jq -r '.id' <<<"$run")"
fi

run_id="$(jq -er '.id' <<<"$run")"
last_version=-1
last_sequence=0
seen_failures=0
seen_warnings=0

detach()
{
    printf '\nDetached; CI Autofix continues in the backend.\n'
    exit 130
}
trap detach INT

while true; do
    run="$(api "$base_url/api/ci-autofix/runs/$run_id")"
    version="$(jq -er '.version' <<<"$run")"
    if [[ "$version" != "$last_version" ]]; then
        jq -r '"run> \(.status | ascii_downcase) / \(.activity | ascii_downcase) — head \(.expectedRemoteHead[0:12]), attempts \(.attemptsUsed)/\(.authorization.maxAttempts), reruns \(.rerunsUsed)"' <<<"$run"
        last_version="$version"
    fi

    failures="$(jq -c '[.attempts[] | .failures[]]' <<<"$run")"
    failure_count="$(jq 'length' <<<"$failures")"
    if (( failure_count > seen_failures )); then
        jq -r --argjson start "$seen_failures" '.[$start:][] | "ci> \(.summary) (workflow \(.workflowRunId), job \(.jobId))"' <<<"$failures"
        seen_failures="$failure_count"
    fi

    warning_count="$(jq '.warnings | length' <<<"$run")"
    if (( warning_count > seen_warnings )); then
        jq -r --argjson start "$seen_warnings" '.warnings[$start:][] | "warning> \(.message)"' <<<"$run"
        seen_warnings="$warning_count"
    fi

    task_id="$(jq -r '.agentTaskId // empty' <<<"$run")"
    if [[ -n "$task_id" ]]; then
        while true; do
            events="$(api "$base_url/agent/tasks/$task_id/events?after=$last_sequence&limit=1000")"
            event_count="$(jq 'length' <<<"$events")"
            while IFS= read -r event; do
                [[ -n "$event" ]] && print_event <<<"$event"
            done < <(jq -c '.[]' <<<"$events")
            if (( event_count > 0 )); then
                last_sequence="$(jq -er '.[-1].sequence' <<<"$events")"
            fi
            (( event_count == 1000 )) || break
        done
    fi

    status="$(jq -er '.status' <<<"$run")"
    if [[ "$status" == FINISHED ]]; then
        jq -r '"finished> \(.finishReason // "UNKNOWN"): \(.summary // "No summary")"' <<<"$run"
        [[ "$(jq -r '.finishReason // ""' <<<"$run")" == GREEN ]]
        exit
    fi
    if [[ "$status" == PAUSED ]]; then
        jq -r '"paused> \(.pauseReason // "UNKNOWN"): \(.summary // "No summary")"' <<<"$run"
        if [[ ! -t 0 ]]; then
            exit 2
        fi
        if ! IFS= read -r -p "Message the agent, /cancel, or /quit: " message || [[ "$message" == /quit ]]; then
            echo "Detached; CI Autofix remains paused."
            exit 2
        fi
        if [[ "$message" == /cancel ]]; then
            run="$(api -X POST "$base_url/api/ci-autofix/runs/$run_id/cancel")"
        elif [[ -n "$message" ]]; then
            run="$(api \
                -H 'Content-Type: application/json' \
                -H "Idempotency-Key: ci-autofix-message-$(date +%s)-$$" \
                -d "$(jq -n --arg message "$message" '{message: $message}')" \
                "$base_url/api/ci-autofix/runs/$run_id/messages")"
        fi
        continue
    fi
    sleep "$poll_seconds"
done
