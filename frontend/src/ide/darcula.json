{
  "name": "ByteQuay Darcula",
  "type": "dark",
  "colors": {
    "editor.background": "#2b2b2b",
    "editor.foreground": "#a9b7c6",
    "editorLineNumber.foreground": "#606366",
    "editor.selectionBackground": "#214283",
    "sideBar.background": "#3c3f41",
    "sideBar.foreground": "#bbbbbb",
    "editorGroupHeader.tabsBackground": "#3c3f41",
    "panel.background": "#2b2b2b",
    "focusBorder": "#537da2",
    "activityBar.background": "#3c3f41",
    "statusBar.background": "#3c3f41"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "foreground": "#808080",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#cc7832"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#6a8759"
      }
    },
    {
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#6897bb"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#ffc66d"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#a9b7c6"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.field"
      ],
      "settings": {
        "foreground": "#9876aa"
      }
    }
  ],
  "semanticHighlighting": true
}
